21--%20iris%20shading%20arc%20--%3E%0A%20%20%3Cpath%20d%3D%22M162%20100%20Q200%2088%20238%20100%22%20fill%3D%22none%22%20stroke%3D%22%232a3a6b%22%20stroke-width%3D%2212%22%20opacity%3D%220.5%22/%3E%0A%3C/svg%3E",
